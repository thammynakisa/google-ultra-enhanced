{
  "manifest_version": 3,
  "name": "G1 Ultra $0 · Pro v3",
  "version": "3.0.0",
  "description": "Google One Ultra $0 — 8-Method Activation Engine. Enhanced with geo offers, Gemini paths, cross-SKU injection, bundle trials.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://one.google.com/*",
    "https://payments.google.com/*",
    "https://tokenized.play.google.com/*",
    "https://play.google.com/*",
    "https://fi.google.com/*",
    "https://gemini.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "G1 Ultra $0 · Pro v3",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "https://one.google.com/*",
        "https://payments.google.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://one.google.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://one.google.com/*",
        "https://payments.google.com/*"
      ],
      "js": ["presets.js", "content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://tokenized.play.google.com/*"],
      "js": ["play_guard.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
